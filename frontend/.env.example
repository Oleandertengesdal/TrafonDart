# Frontend build-time settings. Copy to .env.local for local overrides (git-ignored).
# Everything prefixed VITE_ ends up in the public JavaScript bundle – never put secrets here.

# Where the browser opens the live-score WebSocket.
# Leave empty locally: the Vite dev server proxies /ws to the backend on :8080.
# In production (Vercel) set it to your Render backend, e.g. wss://trafondart-api.onrender.com/ws
VITE_WS_URL=

# Where "Report a bug" sends people. Defaults to adminsjef@uka.no.
VITE_CONTACT_EMAIL=
