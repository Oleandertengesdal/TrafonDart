    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1"
