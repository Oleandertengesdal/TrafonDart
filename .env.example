# TrafonDart – local development settings.
#
#   cp .env.example .env      # .env is git-ignored – NEVER commit it
#
# backend/run-dev.sh and docker-compose.yml read this file. In production these values are set as
# environment variables in the Render dashboard instead (see docs/DEPLOYMENT.md).

# --- Database (matches docker-compose.yml) -----------------------------------------------
POSTGRES_DB=trafondart
POSTGRES_USER=trafondart
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=jdbc:postgresql://localhost:5432/trafondart
DATABASE_USERNAME=trafondart
DATABASE_PASSWORD=change-me-local-only

# --- Auth --------------------------------------------------------------------------------
# At least 32 random bytes. Generate with:  openssl rand -base64 48
# Leave empty locally to get a random per-run secret (you'll be logged out on every restart).
JWT_SECRET=

# --- First admin (only used when the users table is empty) --------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-10-chars
BOOTSTRAP_ADMIN_REAL_NAME=Admin

# --- Web ---------------------------------------------------------------------------------
COOKIE_SECURE=false
WS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_HOPS=0
