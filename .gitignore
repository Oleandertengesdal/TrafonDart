# ---------------------------------------------------------------- secrets – never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.yml
application-local.properties
secrets/

# ---------------------------------------------------------------- backend (Maven / Java)
backend/target/
backend/pom-local.xml
*.class
hs_err_pid*
replay_pid*

# ---------------------------------------------------------------- frontend (Node / Vite)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------- deployment tooling
.vercel/
.render/
# Neon CLI scaffolding (`neon init`): local project link and config. The app reaches Neon only through
# DATABASE_URL (Render), so none of this belongs in the repository. .env.local (the connection string) is
# already ignored by `.env.*` above.
/.neon
/neon.ts
/package.json
/package-lock.json

# ---------------------------------------------------------------- editors & OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# ---------------------------------------------------------------- local scratch
Claude outputs/
*.log
tmp/
.cache/
__pycache__/

# Database backups (contain personal data)
backups/
*.dump
*.sql.gz
